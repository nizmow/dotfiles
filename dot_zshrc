if [[ ! -d ~/.zsh/snap/.git ]]; then
  echo "Installing znap..."
  git clone --depth 1 https://github.com/marlonrichert/zsh-snap.git ~/.zsh/snap
fi
source ~/.zsh/snap/znap.zsh

ZVM_VI_INSERT_ESCAPE_BINDKEY=jk

znap source zsh-users/zsh-autosuggestions
znap source zsh-users/zsh-syntax-highlighting
znap source Aloxaf/fzf-tab
znap source jeffreytse/zsh-vi-mode

function zvm_after_init() {
  [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
}

# znap eval caches in ${XDG_CACHE_HOME:-$HOME/.cache}/zsh-snap/eval
# Cache will be invalidated if command changes, or clear there if required.
alias znap-reset='rm -rf ${XDG_CACHE_HOME:-$HOME/.cache}/zsh-snap/eval'

# Starship
# eval "$(starship init zsh)"
znap eval starship 'starship init zsh'

# zoxide
# eval "$(zoxide init zsh)"
znap eval zoxide 'zoxide init zsh'

# mise
#eval "$(mise activate)"
znap eval mise 'mise activate zsh'

# Set up some nicer copilot aliases
znap eval copilot 'gh copilot alias -- zsh'

# Set up atuin
znap eval atuin 'atuin init zsh'

# Completion
autoload -Uz compinit && compinit

export PATH="~/.bin:$PATH"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh



