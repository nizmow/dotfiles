# yt-dlp via uvx with impersonation
yt-dlp() {
  uvx --python 3.12 --refresh --from "yt-dlp[default,curl-cffi]" yt-dlp "$@"
}
yt-dlp-nightly() {
  uvx --python 3.12 --refresh --prerelease allow \
    --from "yt-dlp[default,curl-cffi]" yt-dlp "$@"
}


